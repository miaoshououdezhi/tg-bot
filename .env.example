# 复制为 .env 后填写。示例值不能用于实际启动；不要提交 .env。
# BotFather /newbot 获得；私密。也可用 BOT_TOKEN_FILE 指向容器内只读秘密文件。
BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
# 管理员 Telegram 数字 ID，不是用户名。管理员先向机器人发送 /start。
ADMIN_ID=REPLACE_WITH_NUMERIC_ADMIN_ID
# 先为此域名配置 DNS A/AAAA 指向部署主机，开放 80/443。
VERIFY_DOMAIN=verify.example.com
ACME_EMAIL=admin@example.com
PUBLIC_URL=https://verify.example.com
# Turnstile widget 为此 hostname 授权。Site Key 可公开，Secret 必须保密。
TURNSTILE_SITE_KEY=REPLACE_WITH_PUBLIC_SITE_KEY
TURNSTILE_SECRET=REPLACE_WITH_PRIVATE_SECRET
TURNSTILE_HOSTNAME=verify.example.com
# TURNSTILE_SECRET_FILE=/run/secrets/turnstile_secret
# 本机直接运行时使用；Compose 固定覆盖为 /app/data/bot.sqlite。
DB_PATH=./data/bot.sqlite
HOST=127.0.0.1
PORT=8080
MESSAGE_USER_LIMIT=20
MESSAGE_GLOBAL_LIMIT=120
DUPLICATE_SECONDS=30
PROMPT_SECONDS=10
CHALLENGE_LIMIT=5
SUBMIT_LIMIT=10
MAX_FILE_BYTES=20971520
MAX_BODY_BYTES=16384
MAX_CHALLENGES=1000
MAX_USER_CHALLENGES=3
MAPPING_RETENTION_DAYS=30
IDENTITY_RETENTION_DAYS=90
# allow 允许正常链接；deny 拒绝含链接消息。不是内容审核服务。
LINK_POLICY=allow
OFFLINE_SECONDS=300
WELCOME_TEXT=欢迎使用联系管理员机器人。请先完成验证，再重新发送消息。支持文字、图片、文件和语音；请勿发送密码、验证码等敏感信息。
OFFLINE_TEXT=管理员暂时无法接收消息，请稍后再试。
# JSON 字符串数组，管理员主动点击发送。无需额外 AI 或付费服务。
QUICK_REPLIES=["您好，已收到您的消息。","请补充问题的具体情况。","问题已处理，感谢联系。"]
